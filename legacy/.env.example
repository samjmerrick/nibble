# PROJECT=nibble                (the bee-database project holding the recipes)
# AI conversion of imports (links and pasted text) into the family format. Without a key, Nibble reads the
# recipe itself and keeps the steps as written. Free key: https://openrouter.ai/keys
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openrouter/free     (or a specific model id, e.g. one ending ":free")
# LLM_BASE_URL=https://openrouter.ai/api/v1
